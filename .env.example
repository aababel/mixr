# Copy to .env and fill in. Never commit .env (this repo is public).
ANTHROPIC_API_KEY=        # optional; the pipeline must work without it
MIXR_STORAGE_DIR=backend/storage
MIXR_CORS_ORIGINS=http://localhost:3000   # comma-separated frontend URLs allowed to call the API
MIXR_CORS_ORIGIN_REGEX=                   # optional, e.g. https://mixr-.*\.vercel\.app for preview deploys
