+def _span_mean(series: np.ndarray | None, hop: float, a: float, b: float) -> float:
+    if series is None or not series.size or hop <= 0:
+        return 0.0
+    i0 = int(a / hop)
+    seg = series[i0:max(i0 + 1, int(np.ceil(b / hop)))]
+    return float(seg.mean()) if seg.size else 0.0
+
